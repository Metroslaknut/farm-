# FARM+ environment variables
# Copy to `.env` for local development: cp .env.example .env
# NEVER commit `.env` or put real secrets in this file.
#
# Load order (first match wins, real process env always wins):
#   .env.<NODE_ENV>.local -> .env.<NODE_ENV> -> .env.local -> .env

# ---------------------------------------------------------------------------
# Shared (API + Worker)
# ---------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production. Staging/production run with NODE_ENV=production (same hardening) and set this label;
# leave unset locally. See deploy/env/*.env.example and docs/ops/environments.md.
# DEPLOY_ENV=staging
# Build identifier shown by /health and in logs (the pipeline sets it).
# GIT_SHA=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (services/api)  — server-only
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins. Required in production.
CORS_ORIGINS=http://localhost:5173

# Seconds the API reports "not ready" after SIGTERM before it stops, so the load balancer drains it first.
# SHUTDOWN_DELAY_MS=5000

# Reverse-proxy hops to trust for the client IP (rate limiting / audit). 0 = none.
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# MongoDB (Atlas: mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/farmplus)
# Local example (needs a running mongod): mongodb://127.0.0.1:27017/farmplus
MONGODB_URI=

# --- Authentication secrets: REQUIRED, server-only, generate your own -----
# 48+ random bytes:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# Encrypts TOTP secrets at rest (32 bytes, base64):  openssl rand -base64 32
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ISSUER=FARM+
# Hosts that animal and community post photo/video/document links may point to (your object-storage/CDN host), comma-separated.
# Empty = any https host in development; media links are refused in production until this is set.
# MEDIA_ALLOWED_HOSTS=cdn.example.com,files.example.com
# Require email/phone verification before login. Defaults to true in production, false otherwise.
# AUTH_REQUIRE_VERIFICATION=true

# Social sign-in (Google / Facebook) — server-only secrets. A button appears only when its id AND secret are set.
# Create the apps at https://console.cloud.google.com/apis/credentials (OAuth client, type "Web application") and
# https://developers.facebook.com/apps (Facebook Login). Register this redirect URI at each provider:
#   <API_PUBLIC_URL>/api/v1/auth/oauth/google/callback   and   <API_PUBLIC_URL>/api/v1/auth/oauth/facebook/callback
# API_PUBLIC_URL=http://localhost:4000
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_FACEBOOK_APP_ID=
# OAUTH_FACEBOOK_APP_SECRET=
# Exact URLs a sign-in may return to: the web callback page and the mobile deep link.
# OAUTH_RETURN_URLS=http://localhost:5173/farms/oauth-callback,farmplus://oauth-callback
# Development only: a fake Google/Facebook provider so the flow can be tried without accounts (refused in production).
# OAUTH_MOCK=false

# ---------------------------------------------------------------------------
# Worker (services/worker) — server-only
# ---------------------------------------------------------------------------
WORKER_NAME=farmplus-worker
# Optional liveness endpoint for the worker (GET /health); unset = no HTTP listener.
# WORKER_HEALTH_PORT=4100

# ---------------------------------------------------------------------------
# Database operations (pnpm --filter @farmplus/api db <command>) — server-only
# ---------------------------------------------------------------------------
# Optional AES-256 key (openssl rand -base64 32) that encrypts backup files. Keep it somewhere OTHER than the backups.
# BACKUP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Web (apps/web) — PUBLIC. Anything prefixed VITE_ is bundled into the client.
# ---------------------------------------------------------------------------
# Leave empty in dev to use the Vite proxy to the API.
VITE_API_BASE_URL=
# Expose the internal /design-system preview page outside development (always on in `pnpm dev:web`).
# VITE_ENABLE_DESIGN_PREVIEW=true
# Build-time (production web build): extra https hosts the page may load media from, comma-separated (default https://*.cloudflarestream.com).
# WEB_MEDIA_HOSTS=https://cdn.example.com
# Make the production build fail when VITE_API_BASE_URL is empty.
# WEB_REQUIRE_API_BASE=true

# ---------------------------------------------------------------------------
# Mobile (apps/mobile) — PUBLIC. Anything prefixed EXPO_PUBLIC_ is bundled.
# (see the notes below — development needs no URL; production needs an https:// one)
# ---------------------------------------------------------------------------
# Expo reads env files from apps/mobile/ (NOT this root file): put overrides in apps/mobile/.env.
# Leave unset in development: the app uses the machine serving the bundle (works on real phones, the iOS
# simulator and the Android emulator). REQUIRED and https:// for production builds.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Build-time only: domain for https universal/app links (needs apple-app-site-association + assetlinks.json hosted there).
# FARMPLUS_LINK_HOST=app.example.com
# EAS builds only: the project id from `eas init` (an identifier, not a credential). See apps/mobile/eas.json.
# EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Reserved for later Parts (not read by any code yet):
#   REDIS_URL, email/SMS provider keys, payment & storage credentials.
# These are server-only and must never be exposed to apps/web or apps/mobile.
# ---------------------------------------------------------------------------

# --- Video & live streaming (Part 10) ---------------------------------------------------------------------------
# `mock` = in-memory stand-in for development/tests only (refused in production). Use `cloudflare` (Stream) for real.
# VIDEO_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=        # server-only; scope: Stream:Edit. Never expose to clients.
# CLOUDFLARE_STREAM_CUSTOMER_CODE=    # the "customer-<code>" part of the playback hostname
# VIDEO_WEBHOOK_SECRET=               # the Stream webhook signing secret (openssl rand -hex 32 if self-generated)
# VIDEO_MAX_UPLOAD_MB=200
# VIDEO_MAX_DURATION_SECONDS=120

# --- Orders & shipping (Part 12) --------------------------------------------------------------------------------
# Without a provider, delivery quotes come only from the seller's own shipping terms on each listing.
# SHIPPING_PROVIDER=none                # `mock` = development/test stand-in, refused in production
# SHIPPING_WEBHOOK_SECRET=              # HMAC secret for carrier status callbacks (POST /api/v1/webhooks/shipping); endpoint is off when unset
# PAYMENT_WEBHOOK_SECRET=               # HMAC secret for payment/refund callbacks (POST /api/v1/webhooks/payments); endpoint is off when unset

# --- Finance (Part 13) --------------------------------------------------------------------------------------------
# PAYMENT_PROVIDER=none                 # `mock` = development/test stand-in, refused in production. No real provider adapter ships yet:
#                                       # online payment stays disabled until one is implemented and its legal/provider review is done.
# PAYMENT_WEBHOOK_SECRET (above) also authenticates charge/refund/payout callbacks (POST /api/v1/webhooks/payments).

# --- AI animal assessment (Part 15) -----------------------------------------------------------------------------
# Assessments are computed from recorded data without any AI. A provider only adds a short plain-language explanation.
# AI_PROVIDER=none                      # `mock` = development/test stand-in (refused in production); `anthropic` = Anthropic Messages API
# AI_API_KEY=                           # server-side secret for the provider; never exposed to apps, never logged or stored
# AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=                          # optional override (proxy / gateway)
# AI_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=700

# --- Mockup test data (development only) -----------------------------------------------------------------------
# Login password (min 12 chars) of every mockup user created by `pnpm seed:mockup`. See docs/ops/mockup-data.md.
# SEED_MOCKUP_PASSWORD=
