# FARM+ API — production environment.  TEMPLATE: contains NO secrets and must never be filled in and committed.
# Set these as variables in your host / secret manager. Values marked <secret> come from the secret manager only.
# Validate before deploying (prints variable NAMES with problems, never values):
#   node services/api/dist/scripts/env-check.js          (or: pnpm --filter @farmplus/api env:check)
# Staging runs with production hardening (NODE_ENV=production) and its own, separate database, keys and providers.

NODE_ENV=production
DEPLOY_ENV=production
LOG_LEVEL=info
GIT_SHA=<set-by-the-deploy-pipeline>

API_HOST=0.0.0.0
API_PORT=4000
# Exact https origins of the web app(s). No wildcards, no http, no localhost (validation refuses them).
CORS_ORIGINS=https://app.example.com
# Number of proxy/load-balancer hops in front of the API (>= 1 in production; 1 = a single load balancer).
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
AUTH_REQUIRE_VERIFICATION=true
SHUTDOWN_DELAY_MS=5000

# MongoDB Atlas: a mongodb+srv:// URI for a DEDICATED, least-privilege application user (readWrite on this database only).
# Migrations/index changes use a separate user (see docs/ops/migrations.md). <secret>
MONGODB_URI=<secret>

# <secret> each: openssl rand -base64 48  /  openssl rand -base64 32. Different values per environment.
JWT_ACCESS_SECRET=<secret>
MFA_ENCRYPTION_KEY=<secret>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ISSUER=FARM+

# Hosts photo/video/document links may point to (your object storage / CDN host).
MEDIA_ALLOWED_HOSTS=cdn.example.com

# Device-uploaded animal photos in Cloudflare R2, served from the bucket's public domain (add it to the web's WEB_MEDIA_HOSTS).
# The API token is scoped to this bucket only (Object Read & Write).
PHOTO_STORAGE=r2
R2_ACCOUNT_ID=<id>
R2_ACCESS_KEY_ID=<secret>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET=farmplus-photos
R2_PUBLIC_BASE_URL=https://photos.example.com

# Streaming (Cloudflare Stream). The mock provider is refused in production and staging.
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=<id>
CLOUDFLARE_STREAM_API_TOKEN=<secret>
CLOUDFLARE_STREAM_CUSTOMER_CODE=<code>
VIDEO_WEBHOOK_SECRET=<secret>
VIDEO_MAX_UPLOAD_MB=200
VIDEO_MAX_DURATION_SECONDS=120

# Orders, payments, shipping. No real payment adapter ships yet: leave PAYMENT_PROVIDER=none until one is built and reviewed.
SHIPPING_PROVIDER=none
PAYMENT_PROVIDER=none
# <secret> each; the matching webhook endpoint stays OFF while its secret is unset.
SHIPPING_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# AI explanations (optional). Assessments work fully with AI_PROVIDER=none.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=700
