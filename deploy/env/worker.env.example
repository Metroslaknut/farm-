# FARM+ worker — TEMPLATE (no secrets). The worker has no queue yet and needs no database or provider credentials.
NODE_ENV=production
DEPLOY_ENV=staging
LOG_LEVEL=info
GIT_SHA=<set-by-the-deploy-pipeline>
WORKER_NAME=farmplus-worker
# Optional liveness endpoint (GET /health). Bind to the private network only.
WORKER_HEALTH_PORT=4100
