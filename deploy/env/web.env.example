# FARM+ web — BUILD-TIME variables. Everything here is PUBLIC (it is compiled into the browser bundle): never put a secret here.
# Set as variables of the CI/CD environment that builds the site.
VITE_API_BASE_URL=https://api.staging.example.com
# Hosts the page may load video/images from (comma-separated, https only). Default: https://*.cloudflarestream.com
WEB_MEDIA_HOSTS=https://*.cloudflarestream.com,https://cdn.staging.example.com,https://photos.staging.example.com
# Make the build fail instead of producing a site that does not know where the API is.
WEB_REQUIRE_API_BASE=true
# VITE_ENABLE_DESIGN_PREVIEW=true   # keep OFF outside development
